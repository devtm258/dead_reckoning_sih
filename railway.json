{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfile": "backend/Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "gunicorn --workers 4 --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 server:app",
    "healthcheck": {
      "interval": 30000,
      "timeout": 3000,
      "start_period": 5000,
      "retries": 3
    },
    "restartPolicy": "on-failure",
    "restartPolicyMaxRetries": 3
  }
}
