# Frontend Environment Variables
# These variables are prefixed with REACT_APP_ and will be available in the React app

# API Configuration
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_ENVIRONMENT=development

# Backend Environment Variables (if running backend separately)
# Keep these in your local .env.local or backend/.env

MONGO_URL=mongodb://localhost:27017
DB_NAME=sih_dr_navigation
CORS_ORIGINS=*

# LLM Integration (Optional - for AI summary feature)
EMERGENT_LLM_KEY=your_emergent_api_key_here

# Flask/FastAPI Configuration (backend)
FLASK_ENV=development
PYTHON_ENV=development
